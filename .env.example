# API
HOST=0.0.0.0
PORT=4000
SESSION_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
SERVE_STATIC=true

# PostgreSQL local. También puedes usar DATABASE_URL en lugar de estas variables.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_with_your_database_password
PGDATABASE=planetour_db
PGADMIN_DATABASE=postgres

# Usuario administrador que sólo se crea si todavía no existe.
ADMIN_EMAIL=admin
ADMIN_NAME=Superadministrador Planetour
ADMIN_PASSWORD=replace_with_a_strong_initial_password
BCRYPT_ROUNDS=12

# Ajustes opcionales del pool PostgreSQL.
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=20000
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
